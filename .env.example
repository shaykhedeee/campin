# CampIn local development environment
# Copy this file to .env.local or .env when you are ready to connect services.

# App
VITE_APP_URL=http://localhost:5173

# Supabase / Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campin-listing-media
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps and enrichment
MAPBOX_ACCESS_TOKEN=
GOOGLE_PLACES_API_KEY=

# Messaging
# Server-only: configure in Netlify, never with a VITE_ prefix.
RESEND_API_KEY=
RESEND_FROM=CampIn <hello@campin.co.in>
LEAD_ALERT_TO=support@campin.co.in
RESEND_WEBHOOK_SECRET=
# Optional browser transport fallback. Keep false unless Netlify Forms is enabled for the site.
VITE_ENABLE_NETLIFY_FORM_FALLBACK=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# AI and research
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=

# Analytics/monitoring
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# Jobs
TRIGGER_SECRET_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
