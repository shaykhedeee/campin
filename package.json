{
  "name": "campin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.config.admin.ts && node tools/generate-sitemap.mjs && node tools/check-deployment-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "research:dry-run": "node tools/research-collector/collector.mjs --provider fixture --dry-run",
    "research:fixture": "node tools/research-collector/collector.mjs --provider fixture --out data/research/outputs",
    "research:site-leads": "node tools/research-collector/collector.mjs --provider site-leads --out data/research/outputs",
    "pdf:extract:help": "python tools/pdf-extract/extract_pdf_text.py --help",
    "ops:check": "node tools/ops-check/ops_check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
